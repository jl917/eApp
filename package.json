  "homepage": "https://github.com/jl917/eapp#readme",
  "dependencies": {
    "@sentry/electron": "^5.9.0",
    "@tanstack/react-router": "^1.85.0",
    "@tanstack/router": "^0.0.1-beta.53",
    "@tanstack/router-plugin": "^1.81.9",
    "antd": "^5.22.2",
