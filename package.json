{
  "name": "eapp",
  "productName": "eapp",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".rsbuild/build/main.js",
  "scripts": {
    "start": "npm run dev",
    "dev": "npm run devWeb & cross-env MODE=dev electron-forge start --inspect-electron",
    "devWeb": "cross-env MODE=dev rsbuild dev --config rsbuild.renderer.config.ts",
    "build": "cross-env MODE=production electron-forge publish",
    "build:beta": "cross-env MODE=beta electron-forge publish --enable-logging",
    "buildWeb": "cross-env MODE=production rsbuild build --config rsbuild.renderer.config.ts",
    "buildWeb:beta": "cross-env MODE=beta rsbuild build --config rsbuild.renderer.config.ts",
    "build:dev": "cross-env MODE=dev electron-forge publish",
    "doctor": "RSDOCTOR=true npm run build && RSDOCTOR=true npm run buildWeb",
    "lint": "eslint --ext .ts,.tsx ./src",
    "fix": "eslint --fix --ext .ts,.tsx ./src",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.5.0",
    "@electron-forge/maker-deb": "^7.5.0",
    "@electron-forge/maker-dmg": "^7.6.0",
    "@electron-forge/maker-rpm": "^7.5.0",
    "@electron-forge/maker-squirrel": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.6.0",
    "@electron-forge/plugin-fuses": "^7.5.0",
    "@electron-forge/publisher-github": "^7.6.0",
    "@electron-forge/publisher-s3": "^7.6.0",
    "@electron/fuses": "^1.8.0",
    "@rsbuild/core": "^1.1.6",
    "@rsbuild/plugin-react": "^1.0.7",
    "@rsdoctor/rspack-plugin": "^0.4.8",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@sentry/webpack-plugin": "^2.22.7",
    "@types/cross-zip": "^4.0.2",
    "@types/debug": "^4.1.12",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.3",
    "cross-env": "^7.0.3",
    "cross-zip": "^4.0.1",
    "debug": "^4.3.7",
    "electron": "33.2.0",
    "electron-installer-dmg": "^5.0.1",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "electron-winstaller": "^5.4.0",
    "eslint": "^8.0.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.25.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "fs-extra": "^11.2.0",
    "listr2": "^8.2.5",
    "prettier": "^3.4.1",
    "realm": "^20.1.0",
    "semantic-release": "^24.2.0",
    "systeminformation": "^5.25.5",
    "ts-node": "^10.0.0",
    "typescript": "^5.6.3",
    "update-electron-app": "^3.0.0",
    "vite": "^5.0.12"
  },
