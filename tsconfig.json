{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "typeRoots": ["./node_modules/@types"],
    "types": [],
    "paths": {
      "@/*": ["src/*"],
      "@main/*": ["src/main/*"],
      "@preload/*": ["src/preload/*"],
      "@renderer/*": ["src/renderer/*"]
    },
    "strictNullChecks": false,
  },
  "include": [
    "src/**/*",
    "forge.env.d.ts",
    "forge.config.ts",
    "build/utils.ts",
    "rsbuild.main.config.ts",
    "rsbuild.preload.config.ts",
    "rsbuild.renderer.config.ts"
, "plugins"  ],
  "exclude": ["node_modules"]
}
